    given-names: "[Author name]"

related-identifiers:
  - type: url
    value: "https://github.com/mahsatorabi/high-performance-sport-concept-network"
    relation: isSupplementTo
    notes: >-
      Companion paper. This repository is second-order: it analyses the concept
      families, network and domain labels produced by that paper's pipeline and reads
      three inputs from it (corpus.json, network_edges.csv, pillar_of.json), all
      withheld here under the Scopus licence.

